# ------------------------------------------------------------------------------------------------
# Small helpers
# ------------------------------------------------------------------------------------------------

def eprint(*a, **k) -> None:
    print(*a, file=sys.stderr, **k)


def die(msg: str, code: int = 2) -> "None":
    eprint(f"support: {msg}")
    sys.exit(code)


def run(cmd: list, timeout: int = 120, input_text: str | None = None) -> tuple:
    """(returncode, stdout, stderr). Never raises."""
    try:
        p = subprocess.run(cmd, input=input_text, capture_output=True, text=True, timeout=timeout,
                           errors="replace", **({} if input_text is not None else {"stdin": subprocess.DEVNULL}))
        return p.returncode, p.stdout or "", p.stderr or ""
    except FileNotFoundError:
        return 127, "", f"{cmd[0]} not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout}s"
    except OSError as err:
        return 126, "", str(err)


def human(n: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return str(n)


def parse_since(text: str) -> int:
    m = re.fullmatch(r"\s*(\d+)\s*([smhd]?)\s*", text or "")
    if not m:
        raise argparse.ArgumentTypeError("use a duration such as 90m, 24h or 3d")
    value = int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
    if not 60 <= value <= 30 * 86400:
        raise argparse.ArgumentTypeError("--since must be between 1m and 30d")
    return value


def utc_now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ask(question: str, assume_yes: bool) -> bool:
    if assume_yes:
        eprint(f"{question} [y/N] y (--yes)")
        return True
    if not sys.stdin.isatty():
        eprint(f"{question} [y/N] no terminal to ask on: answering no. Re-run on a terminal, or pass --yes "
               "after you have reviewed the preview.")
        return False
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def state_dir() -> str:
    d = os.environ.get(STATE_DIR_ENV) or os.path.join(os.path.expanduser("~"), ".nano-support")
    os.makedirs(d, mode=0o700, exist_ok=True)
    with contextlib.suppress(OSError):
        os.chmod(d, 0o700)
    return d


def write_private(path: str, data: str) -> None:
    """Write a file only the current user can read (0600), replacing any old one."""
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(data)


# ------------------------------------------------------------------------------------------------
# nano's bundle tool: find it, load it, reuse its redaction (never a copy of our own)
# ------------------------------------------------------------------------------------------------

def load_bundle_module(path: str):
    """Import nano's nano-support-bundle script as a module (it is a plain Python file)."""
    loader = importlib.machinery.SourceFileLoader("nano_support_bundle", path)
    spec = importlib.util.spec_from_loader("nano_support_bundle", loader)
    if spec is None:
        raise ImportError(path)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    for name in ("Redactor", "read_env", "scrub_payload"):
        if not hasattr(module, name):
            raise ImportError(f"{path} has no {name}: not a nano support bundle tool")
    return module


def find_install_tool(install_dir: str) -> str | None:
    p = os.path.join(install_dir, "scripts", BUNDLE_TOOL_NAME)
    return p if os.path.isfile(p) else None


def install_version(install_dir: str) -> str:
    env_path = os.path.join(install_dir, ".env")
    try:
        with open(env_path, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("NANO_VERSION="):
                    return line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        pass
    return ""


def file_sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def known_release_of(digest: str) -> list:
    return sorted((v for v, d in KNOWN_BUNDLE_TOOL_SHA256.items() if d == digest),
                  key=lambda v: tuple(int(x) for x in v.split(".")))


def download_bundle_tool(version: str, dest_dir: str, fetch=None) -> tuple:
    """Fetch nano's tool for one release, verified against the pinned SHA-256 BEFORE anything is
    written or run. (path, sha256). Raises ValueError for an unknown release or a mismatch."""
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        raise ValueError(f"not a release version: {version!r}")
    expected = KNOWN_BUNDLE_TOOL_SHA256.get(version)
    if not expected:
        raise ValueError(f"nano {version} has no pinned SHA-256 in this tool: pass --bundle-tool PATH "
                         "(nano/scripts/nano-support-bundle from the chart you pulled), or update support")
    url = NANO_RAW_URL.format(version=version)
    if fetch is None:
        def fetch(u):
            with urllib.request.urlopen(u, timeout=60) as resp:
                return resp.read(8 * 2**20)
    data = fetch(url)
    digest = hashlib.sha256(data).hexdigest()
    if digest != expected:
        raise ValueError(f"{url}: SHA-256 {digest} does not match the pinned {expected}; not run")
    path = os.path.join(dest_dir, f"{BUNDLE_TOOL_NAME}-{version}")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    return path, digest


# ------------------------------------------------------------------------------------------------
# Live probes (all output goes through nano's Redactor before it is kept)
# ------------------------------------------------------------------------------------------------

def ch_probe_queries(since_s: int) -> list:
    """ClickHouse system tables. query_log is aggregated: no query text, no literals."""
    s = int(since_s)
    return [
        ("ch-parts-by-partition", "SELECT database, table, partition, count() AS active_parts, sum(rows) AS rows, "
                                  "sum(bytes_on_disk) AS bytes_on_disk FROM system.parts WHERE active "
                                  "GROUP BY database, table, partition ORDER BY active_parts DESC LIMIT 50"),
        ("ch-merges", "SELECT database, table, round(elapsed) AS elapsed_s, round(progress, 3) AS progress, "
                      "num_parts, total_size_bytes_compressed, memory_usage, is_mutation, merge_type "
                      "FROM system.merges ORDER BY elapsed DESC LIMIT 50"),
        ("ch-mutations", "SELECT database, table, mutation_id, create_time, is_done, parts_to_do, "
                         "latest_fail_time, substring(replaceAll(latest_fail_reason, '\\n', ' '), 1, 240) "
                         "AS latest_fail_reason FROM system.mutations "
                         f"WHERE NOT is_done OR create_time > now() - INTERVAL {s} SECOND "
                         "ORDER BY create_time DESC LIMIT 50"),
        ("ch-errors", "SELECT name, code, value, last_error_time, "
                      "substring(replaceAll(last_error_message, '\\n', ' '), 1, 240) AS last_error_message "
                      f"FROM system.errors WHERE last_error_time > now() - INTERVAL {s} SECOND "
                      "ORDER BY last_error_time DESC LIMIT 100"),
        ("ch-query-log-by-hour", "SELECT toStartOfHour(event_time) AS hour, type, query_kind, user, "
                                 "exception_code, count() AS queries, round(avg(query_duration_ms)) AS avg_ms, "
                                 "max(query_duration_ms) AS max_ms, sum(read_rows) AS read_rows, "
                                 "sum(read_bytes) AS read_bytes, max(memory_usage) AS max_memory "
                                 f"FROM system.query_log WHERE event_time > now() - INTERVAL {s} SECOND "
                                 "AND type != 'QueryStart' GROUP BY hour, type, query_kind, user, exception_code "
                                 "ORDER BY hour, queries DESC LIMIT 2000"),
        ("ch-query-log-slowest-shapes", "SELECT normalized_query_hash, any(query_kind) AS query_kind, any(user) AS user, "
                                        "count() AS queries, quantile(0.5)(query_duration_ms) AS p50_ms, "
                                        "quantile(0.95)(query_duration_ms) AS p95_ms, max(query_duration_ms) AS max_ms, "
                                        "max(read_rows) AS max_read_rows, max(memory_usage) AS max_memory, "
                                        "countIf(exception_code != 0) AS failed, "
                                        "groupUniqArray(10)(exception_code) AS exception_codes "
                                        f"FROM system.query_log WHERE event_time > now() - INTERVAL {s} SECOND "
                                        "AND type != 'QueryStart' GROUP BY normalized_query_hash "
                                        "ORDER BY p95_ms DESC LIMIT 30"),
        ("ch-query-log-exceptions", "SELECT exception_code, errorCodeToName(exception_code) AS error_name, "
                                    "query_kind, user, count() AS queries, min(event_time) AS first_seen, "
                                    "max(event_time) AS last_seen FROM system.query_log "
                                    f"WHERE event_time > now() - INTERVAL {s} SECOND AND exception_code != 0 "
                                    "GROUP BY exception_code, query_kind, user ORDER BY queries DESC LIMIT 100"),
        ("ch-disks", "SELECT name, path, free_space, total_space, keep_free_space, type FROM system.disks"),
        ("ch-memory", "SELECT metric, value FROM system.asynchronous_metrics WHERE metric IN "
                      "('OSMemoryTotal', 'OSMemoryAvailable', 'CGroupMemoryTotal', 'CGroupMemoryUsed', "
                      "'MemoryResident', 'MaxPartCountForPartition', 'Uptime') ORDER BY metric"),
        ("ch-settings", "SELECT name, value, changed FROM system.server_settings WHERE name IN "
                        "('max_server_memory_usage', 'max_server_memory_usage_to_ram_ratio', "
                        "'background_pool_size', 'max_concurrent_queries', 'max_partitions_per_insert_block') "
                        "OR (changed AND name LIKE '%memory%')"),
        ("ch-merge-tree-settings", "SELECT name, value FROM system.merge_tree_settings WHERE name IN "
                                   "('parts_to_delay_insert', 'parts_to_throw_insert', 'max_parts_in_total')"),
        ("ch-migrations", "SELECT * FROM system.tables WHERE database = currentDatabase() AND name LIKE '%migrations%' "
                          "FORMAT Null"),  # existence probe only; the next probe reads it
    ]


CH_MIGRATIONS_SQL = ("SELECT * FROM {table} ORDER BY 1 DESC LIMIT 15")

